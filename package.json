{
  "name": "az-walcron",
  "version": "1.0.0",
  "description": "A high-performance Rust web server built with the Axum framework, serving both the REST API and a lightweight HTML frontend. Optimized for fast Azure Container Apps cold starts with a single native binary.  Integrated with OTEL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dapr run --app-id az-walcron --app-port 3000 --dapr-http-port 3500 --resources-path ./components --config ./components/dapr-config.yaml -- tsx watch src/index.ts ",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outdir=dist",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "chunk": "tsx src/chunk.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoonghan/az-walcron.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yoonghan/az-walcron/issues"
  },
  "homepage": "https://github.com/yoonghan/az-walcron#readme",
  "dependencies": {
    "@azure/app-configuration": "^1.12.1",
    "@azure/app-configuration-provider": "^2.6.0",
    "@azure/cosmos": "^4.10.0",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-opentelemetry": "^1.18.2",
    "@dapr/dapr": "^3.18.0",
    "@hono/node-server": "^2.0.12",
    "@hono/otel": "^1.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@types/node": "^26.1.1",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
